{
  "manifest_version": 3,
  "name": "ANGELICA Capture",
  "version": "0.1.0",
  "description": "Capture web pages to local ANGELICA Second Brain",
  "icons": {
    "128": "assets/icon.png"
  },
  "action": {
    "default_title": "ANGELICA Capture",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "notifications",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
